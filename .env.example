# Local-development-only values for compose.yaml. Do not reuse these credentials.
POSTGRES_DB=intelliq
POSTGRES_USER=intelliq
POSTGRES_PASSWORD=intelliq_dev_only

# Use this when the backend runs on the host alongside the Compose database.
DATABASE_URL=postgresql+psycopg://intelliq:intelliq_dev_only@127.0.0.1:5434/intelliq

# API settings are loaded from apps/api/.env, not this root file. Copy
# apps/api/.env.example to apps/api/.env for host-run API and worker processes.
# Compose-only Redis settings live here for the local Redis service.

# RustFS local-only credentials. Keep in sync with apps/api/.env.
S3_ACCESS_KEY_ID=INTELLIQLOCAL
S3_SECRET_ACCESS_KEY=intelliq-local-storage-only
