DATA_MODE=fixture
TIMECUE_API_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6381/0
JOBS_ENABLED=false
SIMULATION_PROCESS_ENABLED=true
SIMULATION_TIMEOUT_SECONDS=180
# Required for live mode with background jobs; generate with Fernet.generate_key().
SESSION_ENCRYPTION_KEY=
UPLOAD_DIR=./data/uploads
# Host-run backend URL for the Postgres service in ../compose.yaml.
# The credentials are local-development-only and must not be reused elsewhere.
DATABASE_URL=postgresql+psycopg://intelliq:intelliq_dev_only@127.0.0.1:5434/intelliq
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://intelliq.localhost:8082
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TIMECUE_ACCESS_COOKIE=access_token
TIMECUE_REFRESH_COOKIE=refresh_token
# Samples per evaluated option. Use 20 for a faster, less precise live demo.
SIMULATION_DEFAULT_SAMPLES=100
SIMULATION_MAX_SAMPLES=500
# Optional portfolio-size limits. Zero disables the limit.
SIMULATION_MAX_PROJECTS=0
SIMULATION_MAX_WORKERS=0
SIMULATION_MAX_TASKS=0
# Optional evidence provider; both flags must be true before external text processing.
NLP_ENABLED=true
ALLOW_EXTERNAL_TEXT_PROCESSING=false
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# LLM_API_KEY is an alternative alias; configure only one key alias.
WEATHERAPI_API_KEY=
WEATHER_FORECAST_DAYS=7
OPENROUTESERVICE_API_KEY=
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_BUCKET=intelliq-uploads
S3_REGION=us-east-1
# Local-only credentials; match compose.yaml. Never use these in deployment.
S3_ACCESS_KEY_ID=INTELLIQLOCAL
S3_SECRET_ACCESS_KEY=intelliq-local-storage-only
S3_CREATE_BUCKET=true
